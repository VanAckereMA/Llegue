<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display_black"
            android:fontVariationSettings="'wght' 900"
            android:includeFontPadding="false"
            android:text="@string/app_title"
            android:textColor="?attr/contentPrimary"
            android:textFontWeight="900"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/home_tagline"
            android:textColor="?attr/contentPrimary"
            android:textSize="18sp" />

        <Button
            android:id="@+id/createSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_brand_button"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/home_create_session"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/listState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/home_sessions_title"
                android:textColor="?attr/contentPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/addSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_brand_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="40dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/home_create_session"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/sessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="56dp" />

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/themePanel"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="16dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/themeSwitch"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_theme_switch"
            android:clickable="true"
            android:contentDescription="@string/theme_switch"
            android:focusable="true"
            android:padding="4dp"
            android:visibility="gone">

            <View
                android:id="@+id/themeThumb"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_theme_switch_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/themeSun"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_theme_sun" />

                <ImageView
                    android:id="@+id/themeMoon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_theme_moon" />

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/themeTab"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_theme_tab"
            android:clickable="true"
            android:contentDescription="@string/theme_tab_show"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/theme_tab_open"
            android:textColor="?attr/contentPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
