<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_session_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="12dp">

    <View
        android:id="@+id/statusAccent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="?attr/statusInactive" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/contentPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/contentSecondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/codeWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/contentSecondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/contentSecondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/interval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/contentSecondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/nextSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/contentSecondary"
            android:textSize="16sp" />

    </LinearLayout>

    <Switch
        android:id="@+id/activeSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:showText="false"
        android:splitTrack="false"
        android:thumb="@drawable/session_switch_thumb"
        android:track="@drawable/session_switch_track"
        android:trackTint="@color/session_switch_track"
        android:trackTintMode="src_in" />

</LinearLayout>
